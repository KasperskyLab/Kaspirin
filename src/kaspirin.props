<Project>
	<PropertyGroup>
		<SourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</SourceRoot>
		<RepoRoot>$(SourceRoot)\..\</RepoRoot>
		<TemporaryDirectory>$(SourceRoot)\_temp\</TemporaryDirectory>
		<OutputDirectory>$(SourceRoot)\_out\</OutputDirectory>
		<GeneratedDirectory>$(SourceRoot)_generated\$(Platform)\</GeneratedDirectory>
		<GeneratedProjectDirectory>$(GeneratedDirectory)$(ProjectName)\</GeneratedProjectDirectory>
		<BaseIntermediateOutputPath>$(TemporaryDirectory)$(Platform)\$(Configuration)\$(TargetFramework)\$(AssemblyName)\</BaseIntermediateOutputPath>
		<IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
		<MSBuildProjectExtensionsPath>$(TemporaryDirectory)$(TargetFramework)\$(AssemblyName)\</MSBuildProjectExtensionsPath>
		<OutputPath>$(OutputDirectory)$(TargetFramework)\$(Configuration)\</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
		<Platforms>AnyCPU</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SourcesDirectory>$(MSBuildThisFileDirectory)</SourcesDirectory>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<DebugType>pdbonly</DebugType>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>10</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<FrameworkProps>$(MSBuildThisFileDirectory)Kaspirin.UI.Framework\framework.props</FrameworkProps>
		<FrameworkUIKitProps>$(MSBuildThisFileDirectory)Kaspirin.UI.Framework.UiKit\framework.uikit.props</FrameworkUIKitProps>
		<FrameworkUIKitStylesProps>$(MSBuildThisFileDirectory)Kaspirin.UI.Framework.UiKit.Styles\framework.uikit.styles.props</FrameworkUIKitStylesProps>
		<FrameworkUIKitMediaProps>$(MSBuildThisFileDirectory)Kaspirin.UI.Framework.UiKit.Media\framework.uikit.media.props</FrameworkUIKitMediaProps>
		<FrameworkCodeAnalysisProps>$(MSBuildThisFileDirectory)utilities\Kaspirin.UI.Framework.CodeAnalysis\framework.codeanalysis.props</FrameworkCodeAnalysisProps>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
		<PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.InteropServices.ComVisible">
			<_Parameter1>false</_Parameter1>
			<_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
