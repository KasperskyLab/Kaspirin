<CodeSnippets
    xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>DependencyProperty</Title>
			<Shortcut>propdep</Shortcut>
			<Description>Inserts DependencyProperty in #Region and with CLR property wrapper</Description>
			<Author>Kaspirin</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="CSharp" Kind="method decl">
				<![CDATA[#region $PropertyName$

public $PropertyType$ $PropertyName$
{
    get => ($PropertyType$)GetValue($PropertyName$Property);
    set => SetValue($PropertyName$Property, value);
}

public static readonly DependencyProperty $PropertyName$Property = DependencyProperty.Register(
    nameof($PropertyName$),
    typeof($PropertyType$),
    typeof($OwnerType$),
    new PropertyMetadata(default($PropertyType$)));

#endregion]]>
			</Code>
			<Declarations>
				<Literal>
					<ID>PropertyType</ID>
					<ToolTip>Property type</ToolTip>
					<Default>object</Default>
				</Literal>
				<Literal>
					<ID>PropertyName</ID>
					<ToolTip>Property name</ToolTip>
					<Default>Value</Default>
				</Literal>
				<Literal>
					<ID>OwnerType</ID>
					<ToolTip>Property owner type</ToolTip>
					<Default>ownerclass</Default>
				</Literal>
			</Declarations>
			<Imports>
				<Import>
					<Namespace>System.Windows</Namespace>
				</Import>
			</Imports>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>