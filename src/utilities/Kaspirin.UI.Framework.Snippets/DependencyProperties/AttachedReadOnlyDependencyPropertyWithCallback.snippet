<CodeSnippets
    xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>Attached ReadOnly DependencyProperty with callback</Title>
			<Shortcut>propdeparc</Shortcut>
			<Description>Inserts Attached ReadOnly DependencyProperty (with ValueChanged callback) in #Region and with CLR property wrapper</Description>
			<Author>Kaspirin</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="CSharp" Kind="method decl">
				<![CDATA[#region $PropertyName$

public static $PropertyType$ Get$PropertyName$(DependencyObject obj)
    => ($PropertyType$)obj.GetValue($PropertyName$Property);

private static void Set$PropertyName$(DependencyObject obj, $PropertyType$ value)
    => obj.SetValue(_$PropertyName$PropertyKey, value);

private static readonly DependencyPropertyKey _$PropertyName$PropertyKey = DependencyProperty.RegisterAttachedReadOnly(
    "$PropertyName$",
    typeof($PropertyType$),
    typeof($OwnerType$),
    new PropertyMetadata(default($PropertyType$), On$PropertyName$Changed));

public static readonly DependencyProperty $PropertyName$Property = _$PropertyName$PropertyKey.DependencyProperty;

private static void On$PropertyName$Changed(DependencyObject d, DependencyPropertyChangedEventArgs e)
    => (($OwnerType$)d).On$PropertyName$Changed();

#endregion

private void On$PropertyName$Changed()
{
    throw new NotImplementedException();
}]]>
			</Code>
			<Declarations>
				<Literal>
					<ID>PropertyType</ID>
					<ToolTip>Property type</ToolTip>
					<Default>object</Default>
				</Literal>
				<Literal>
					<ID>PropertyName</ID>
					<ToolTip>Property name</ToolTip>
					<Default>Value</Default>
				</Literal>
				<Literal>
					<ID>OwnerType</ID>
					<ToolTip>Property owner type</ToolTip>
					<Default>ownerclass</Default>
				</Literal>
			</Declarations>
			<Imports>
				<Import>
					<Namespace>System.Windows</Namespace>
				</Import>
			</Imports>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>